{
  "name": "snapshot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @snapshot/server --filter @snapshot/web dev",
    "dev:server": "pnpm --filter @snapshot/server dev",
    "dev:web": "pnpm --filter @snapshot/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @snapshot/core test",
    "postinstall": "pnpm --filter @snapshot/server exec playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  }
}
