{
  "name": "snapshot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @snapshot/server --filter @snapshot/web dev",
    "dev:server": "pnpm --filter @snapshot/server dev",
    "dev:web": "pnpm --filter @snapshot/web dev",
    "build": "pnpm -r build",
    "replay": "tsx scripts/replay-har.ts",
    "test": "pnpm --filter @snapshot/core test && pnpm --filter @snapshot/replay test",
    "deploy:vm": "./deploy/vm-deploy.sh",
    "deploy:container": "./deploy/container-deploy.sh",
    "postinstall": "pnpm --filter @snapshot/replay exec playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@snapshot/core": "workspace:*",
    "@snapshot/replay": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
